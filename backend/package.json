{
  "name": "intellibooks-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "nodemon -L --watch src --ext ts,json --exec ts-node src/index.ts",
    "smoke-test": "ts-node scripts/smoke-test.ts",
    "test:isolation": "ts-node scripts/isolation-test.ts",
    "migrate": "ts-node scripts/run-migrations.ts",
    "prisma:generate": "ts-node scripts/prisma.ts generate",
    "prisma:migrate": "ts-node scripts/prisma.ts migrate dev",
    "prisma:deploy": "ts-node scripts/prisma.ts migrate deploy",
    "prisma:status": "ts-node scripts/prisma.ts migrate status"
  },
  "dependencies": {
    "@clerk/express": "^1.0.0",
    "@prisma/client": "^6.19.3",
    "@types/pdf-parse": "^1.1.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "groq-sdk": "^1.6.0",
    "mammoth": "^1.13.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5",
    "pgvector": "^0.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.0",
    "nodemon": "^3.1.0",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
