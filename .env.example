# ---------------------------------------------------------------------------
# IntelliBooks / PaperChat — copy to .env and fill in real values.
#   cp .env.example .env
# Never commit the real .env file.
# ---------------------------------------------------------------------------

# --- Clerk (required) ------------------------------------------------------
# Dashboard → your app → API keys
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# --- Chat model: Groq (required) -------------------------------------------
# Free key: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-20b

# --- Embeddings: Google Gemini (required) ----------------------------------
# Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EMBEDDING_MODEL=gemini-embedding-001
# Must equal the vector(N) column in prisma/schema.prisma (768).
EMBEDDING_DIMS=768
EMBEDDING_BATCH_SIZE=32

# --- Original upload storage ------------------------------------------------
# Original files are saved to this directory on local disk.
# Defaults to `./uploads` (mounted to ./backend/uploads in Docker Compose).
UPLOAD_DIR=

# --- Database --------------------------------------------------------------
# Docker Compose overrides this with the local `db` service.
# For local (non-Docker) development use localhost; docker-compose maps 5433.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/intellibooks

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT=8000
FRONTEND_URL=http://localhost:3000
MAX_FILE_SIZE_MB=20

# --- RAG tuning ------------------------------------------------------------
# Cosine similarity gate. Raise if the app answers questions the doc can't.
MIN_SCORE=0.6
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
